generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id              Int             @id @default(autoincrement())
  name            String?
  email           String?
  phone           String?
  platform        String
  sourceId        String          @unique
  status          LeadStatus      @default(NEW)
  assignedAgentId Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  aiEnabled       Boolean         @default(true)
  auditLogs       AuditLog[]
  conversations   Conversation[]
  escalations     EscalationLog[]
  agent           Agent?          @relation("AgentLeads", fields: [assignedAgentId], references: [id])
  notifications   Notification[]
  payments        Payment[]

  @@index([phone])
  @@index([email])
  @@index([status])
}

model Agent {
  id            Int             @id @default(autoincrement())
  name          String
  email         String          @unique
  passwordHash  String
  role          AgentRole       @default(AGENT)
  isOnline      Boolean         @default(false)
  createdAt     DateTime        @default(now())
  conversations Conversation[]
  escalations   EscalationLog[]
  leads         Lead[]          @relation("AgentLeads")
  notifications Notification[]
}

model Conversation {
  id        Int       @id @default(autoincrement())
  leadId    Int
  agentId   Int?
  platform  String
  status    String    @default("active")
  createdAt DateTime  @default(now())
  agent     Agent?    @relation(fields: [agentId], references: [id])
  lead      Lead      @relation(fields: [leadId], references: [id])
  messages  Message[]

  @@index([leadId])
  @@index([status])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  role           MessageRole  @default(USER)
  content        String
  intent         String?
  confidence     Float?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model Payment {
  id                Int           @id @default(autoincrement())
  leadId            Int
  razorpayLinkId    String?
  razorpayPaymentId String?
  shortUrl          String?
  amount            Float
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  retryCount        Int           @default(0)
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  courseDuration    String?
  courseName        String?
  courseTiming      String?
  lead              Lead          @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@map("Payment")
}

model EscalationLog {
  id          Int       @id @default(autoincrement())
  leadId      Int
  agentId     Int?
  reason      String
  escalatedAt DateTime  @default(now())
  resolvedAt  DateTime?
  agent       Agent?    @relation(fields: [agentId], references: [id])
  lead        Lead      @relation(fields: [leadId], references: [id])

  @@index([leadId])
}

model IntentLog {
  id         Int      @id @default(autoincrement())
  senderId   String
  message    String
  intent     String
  confidence Float
  reason     String
  escalated  Boolean  @default(false)
  timestamp  DateTime @default(now())

  @@index([senderId])
}

model TokenLog {
  id               Int      @id @default(autoincrement())
  senderId         String
  model            String
  intent           String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  timestamp        DateTime @default(now())

  @@index([senderId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  leadId      Int
  oldStatus   String
  newStatus   String
  reason      String
  triggeredBy String
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id])

  @@index([leadId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  agentId   Int
  leadId    Int
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id])
  lead      Lead     @relation(fields: [leadId], references: [id])

  @@index([agentId])
  @@index([leadId])
  @@index([isRead])
}

enum LeadStatus {
  NEW
  CONTACTED
  ENGAGED
  QUALIFIED
  INFO_COLLECTED
  READY_TO_PAY
  PAYMENT_SENT
  PAID
  ESCALATED
  CONVERTED
  CLOSED
  LOST
  HUMAN_ASSIGNED
}

enum AgentRole {
  ADMIN
  AGENT
}

enum MessageRole {
  USER
  AI
  AGENT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
