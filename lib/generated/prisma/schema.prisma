generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id              Int        @id @default(autoincrement())
  name            String?
  email           String?
  phone           String?
  platform        String
  sourceId        String     @unique
  status          LeadStatus @default(NEW)
  assignedAgentId Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  agent         Agent?          @relation("AgentLeads", fields: [assignedAgentId], references: [id])
  conversations Conversation[]
  payments      Payment[]
  escalations   EscalationLog[]
  auditLogs     AuditLog[]
}

model Agent {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  role         AgentRole @default(AGENT)
  isOnline     Boolean   @default(false)
  createdAt    DateTime  @default(now())

  leads         Lead[]          @relation("AgentLeads")
  conversations Conversation[]
  escalations   EscalationLog[]
}

model Conversation {
  id        Int      @id @default(autoincrement())
  leadId    Int
  agentId   Int?
  platform  String
  status    String   @default("active")
  createdAt DateTime @default(now())

  lead     Lead      @relation(fields: [leadId], references: [id])
  agent    Agent?    @relation(fields: [agentId], references: [id])
  messages Message[]
}

model Message {
  id             Int         @id @default(autoincrement())
  conversationId Int
  role           MessageRole @default(USER)
  content        String
  intent         String?
  confidence     Float?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
}

model Payment {
  id Int @id @default(autoincrement())

  leadId Int

  razorpayLinkId String?

  razorpayPaymentId String?

  shortUrl String?

  amount Float

  currency String @default("INR")

  status PaymentStatus @default(PENDING)

  paidAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@map("payments")
}

model EscalationLog {
  id          Int       @id @default(autoincrement())
  leadId      Int
  agentId     Int?
  reason      String
  escalatedAt DateTime  @default(now())
  resolvedAt  DateTime?

  lead  Lead   @relation(fields: [leadId], references: [id])
  agent Agent? @relation(fields: [agentId], references: [id])
}

model IntentLog {
  id         Int      @id @default(autoincrement())
  senderId   String
  message    String
  intent     String
  confidence Float
  reason     String
  escalated  Boolean  @default(false)
  timestamp  DateTime @default(now())

  @@index([senderId])
}

model TokenLog {
  id               Int      @id @default(autoincrement())
  senderId         String
  model            String
  intent           String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  timestamp        DateTime @default(now())

  @@index([senderId])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  leadId      Int
  oldStatus   String
  newStatus   String
  reason      String
  triggeredBy String // "ai" / "agent" / "system" / "razorpay"
  createdAt   DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id])
}

enum LeadStatus {
  NEW
  CONTACTED
  ENGAGED // ← new
  QUALIFIED
  INFO_COLLECTED // ← new
  READY_TO_PAY
  PAYMENT_SENT // ← new
  PAID // ← new
  ESCALATED // ← new
  CONVERTED
  CLOSED // ← new
  LOST
}

enum AgentRole {
  ADMIN
  AGENT
}

enum MessageRole {
  USER
  AI
  AGENT
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
